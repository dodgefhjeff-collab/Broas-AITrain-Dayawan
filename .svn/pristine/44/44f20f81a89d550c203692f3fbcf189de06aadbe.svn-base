using System;

namespace WaterStation.Client.Model.LayoutDto
{
    /// <summary>
    /// 数据查询实体
    /// </summary>
    public class BufaData 
    {
        /// <summary>
        /// 主键ID
        /// </summary>
        public long ID { get; set; }

        public DateTime CollectTime { get; set; }

        /// <summary>
        ///AmmoniaADValue
        /// </summary>
        public decimal ADVal { get; set; }

        /// <summary>
        ///总氮
        /// </summary>
        public decimal TNVal { get; set; }

        /// <summary>
        ///总磷
        /// </summary>
        public decimal TPVal { get; set; }

        /// <summary>
        ///COD值
        /// </summary>
        public decimal CODVal { get; set; }

        /// <summary>
        ///导电率值
        /// </summary>
        public decimal DDLVal { get; set; }

        /// <summary>
        ///浊度值
        /// </summary>
        public decimal TurbidityVal { get; set; }
        /// <summary>
        ///溶解氧
        /// </summary>
        public decimal RJYVal { get; set; }

        /// <summary>
        ///ph值
        /// </summary>
        public decimal PhVal { get; set; }
        /// <summary>
        ///叶绿素
        /// </summary>
        public decimal Yelvsu { get; set; }
        /// <summary>
        ///蓝藻
        /// </summary>
        public decimal Lanzao { get; set; }
        /// <summary>
        ///水温
        /// </summary>
        public decimal WaterTemperatureVal { get; set; }

        /// <summary>
        ///室温
        /// </summary>
        public decimal RoomTemperature { get; set; }

        /// <summary>
        ///湿度
        /// </summary>
        public decimal HumidityVal { get; set; }

        /// <summary>
        ///压力
        /// </summary>
        public decimal PressureVal { get; set; }

        /// <summary>
        /// 烟感
        /// </summary>
        public string SmokeVal { get; set; }

        /// <summary>
        /// 浸水
        /// </summary>
        public string ImmersionVal { get; set; }
    }
}

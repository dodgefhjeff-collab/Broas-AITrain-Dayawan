using NLog;
using Sunny.UI;
using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO.Ports;
using System.Threading.Tasks;
using System.Windows.Forms;
using WaterStation.Client.Controller;
using WaterStation.Client.Model.LayoutDto;

namespace WaterStation.Client.LayoutManageMoudle
{
    /// <summary>
    /// 实时数据
    /// </summary>
    public partial class RealTimeDataForm : Form
    {
        private static readonly Color NormalTitleColor = Color.FromArgb(26, 101, 143);
        private static readonly Color ErrorTitleColor = Color.Red;

        List<SerialPort> SerialPortList = new();
        private readonly Logger _logger = LogManager.GetCurrentClassLogger();
        System.Timers.Timer timer = new();

        public RealTimeDataForm()
        {
            InitializeComponent();
            // 仅配置定时器参数，不在构造函数中直接启动，避免句柄尚未创建就触发回调
            timer.Interval = 3000;
            timer.Elapsed += new System.Timers.ElapsedEventHandler(ReData); // 刷新数据

            // 在窗体 Load 事件中再初始化数据和启动定时器，确保句柄已经创建
            this.Load += RealTimeDataForm_Load;
        }

        /// <summary>
        /// 窗体加载完成后的初始化逻辑
        /// </summary>
        private async void RealTimeDataForm_Load(object sender, EventArgs e)
        {
            try
            {
                await GetBaudRateList();
                timer.Enabled = true;
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "RealTimeDataForm 加载时初始化失败");
            }
        }

        private void ReData(object sender, EventArgs e)
        {
            // 如果句柄尚未创建或窗体已经释放，则不再更新界面，避免 BeginInvoke 抛出异常
            if (!IsHandleCreated || IsDisposed)
            {
                return;
            }

            this.BeginInvoke(new Action(() =>
            {
                try
                {
                    lbZD.Text = Global.RecentValZD.ToString();
                    lbZD_YB.Text = Global.YBRecentValZD.ToString();
                    lbAIAlarm.Text = Global.IsAIAlarm;
                    ApplyAICommStyle(Global.IsAICommError);
                    ApplyYBCommStyle(Global.IsYBCommError);
                }
                catch (Exception ex)
                {
                    _logger.Error(ex, "RealTimeDataForm 刷新界面失败");
                }
            }));
        }

        /// <summary>
        /// AI 通信异常时：「AI数据」卡片标题/数值变红（流程图旁不再显示「通信异常」标签）
        /// </summary>
        private void ApplyAICommStyle(bool isError)
        {
            SetTitlePanelStyle(groupBox1, isError);
            lbZD.ForeColor = isError ? ErrorTitleColor : NormalTitleColor;
            label2.ForeColor = isError ? ErrorTitleColor : NormalTitleColor;
        }

        /// <summary>
        /// 仪表通信异常时：「仪表数据」卡片标题/数值变红
        /// </summary>
        private void ApplyYBCommStyle(bool isError)
        {
            SetTitlePanelStyle(uiTitlePanel1, isError);
            lbZD_YB.ForeColor = isError ? ErrorTitleColor : NormalTitleColor;
            label18.ForeColor = isError ? ErrorTitleColor : NormalTitleColor;
        }

        private static void SetTitlePanelStyle(UITitlePanel panel, bool isError)
        {
            Color color = isError ? ErrorTitleColor : NormalTitleColor;
            panel.TitleColor = color;
            panel.RectColor = color;
        }

        private async Task<List<SerialPort>> GetBaudRateList()
        {
            try
            {
                var a = await DataAPI.GetAllSystemParaAsync();
                if (a.Count == 0) return null;
                for (int i = 0; i < a.Count; i++)
                {
                    var BaudRate = Convert.ToInt32(a[i].BTL);
                    var ComName = a[i].ComName;
                    var serialPortInfo = new SerialPort(ComName, BaudRate);
                    SerialPortList.Add(serialPortInfo);
                }
                Global.SerialPortList = SerialPortList;
                return SerialPortList;
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                return null;
            }
        }

        private void lbAIAlarm_Click(object sender, EventArgs e)
        {
            if (lbAIAlarm.Text == "1")
            {
                lbAIAlarm.Text = "";
                Global.IsAIAlarm = "";
            }
        }
    }
}

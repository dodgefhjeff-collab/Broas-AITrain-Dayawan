<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows7.0</TargetFramework>
    <!-- 避免 bin\x86\Release\...，否则 dotnet run -p:Platform=x86 会去错误的 bin\Release\... 找 exe -->
    <AppendPlatformToOutputPath>true</AppendPlatformToOutputPath>
     <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>logo.ico</ApplicationIcon>
	<SatelliteResourceLanguages>XXX</SatelliteResourceLanguages>
	<Platforms>AnyCPU;x86</Platforms>
	<UseWPF>True</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Png\**" />
    <EmbeddedResource Remove="Png\**" />
    <None Remove="Png\**" />
    <Page Remove="Png\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="View\LayoutManageMoudle\Form1.cs" />
    <Compile Remove="View\LayoutManageMoudle\Form1.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="View\LayoutManageMoudle\Form1.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="NLog.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Common" Version="137.0.100" />
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="137.0.100" />
    <PackageReference Include="Ding.QRCode.QRCoder" Version="1.1.8" />
    <PackageReference Include="DotNetCore.NPOI" Version="1.2.3" />
    <PackageReference Include="MQTTnet" Version="4.3.3.952" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NLog" Version="5.0.1" />
    <PackageReference Include="NPOI" Version="2.5.6" />
    <PackageReference Include="SqlSugarCore" Version="5.0.3.4" />
    <PackageReference Include="System.IO.Ports" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SunnyUI\SunnyUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="View\UserManageMoudle\FormReFunctionEdit.cs" />
    <Compile Update="View\UserManageMoudle\FormRoleFunctionSubEdit.cs" />
    <Compile Update="View\UserManageMoudle\FormRoleEdit.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>

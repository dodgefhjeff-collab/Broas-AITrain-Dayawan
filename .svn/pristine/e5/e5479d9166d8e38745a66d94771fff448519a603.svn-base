using System;
using System.Collections.Generic;
using System.IO.Ports;
using System.Linq;
using System.Text;
using System.Threading;
using System.Threading.Tasks;
using System.Windows;

namespace WaterStation.Client
{
    //数值传输按CDBA传输
    public class AIMonitor
    {
        private readonly object _syncRoot = new object();
        private SerialPort _serialPort;
        public class PortInfo    //从站串口参数信息
        {
            public string Name { get; set; }
            public int BaudRate { get; set; }
            public Parity Parity { get; set; }
            public StopBits StopBits { get; set; }
            public int DataBits { get; set; }

            public int SlaveID { get; set; }
        }
        private PortInfo _portInfo { get; set; }
        public bool IsOpen => _serialPort != null && _serialPort.IsOpen;

        private bool _isSubscribed = false;  //用于删除订阅
        public SerialDataReceivedEventHandler DataReceivedHandler;

        public class Registers
        {
            // 输入寄存器（只读）- 功能码04访问
            public const ushort AI_TestTime = 0x0000;
            public const ushort AI_ZD = 0x0002;
            public const ushort AI_AD = 0x0004;
            public const ushort AI_COD = 0x0006;
            public const ushort AI_ZL = 0x0008;
            public const ushort AI_Blank1 = 0x000A;
            public const ushort AI_Blank2 = 0x000C;
            public const ushort AI_Blank3 = 0x000E;
            public const ushort AI_Blank4 = 0x0010;
            public const ushort AI_Blank5 = 0x0012;
            public const ushort AI_Blank6 = 0x0014;
            public const ushort AI_Blank7 = 0x0016;
            public const ushort AI_Blank8 = 0x0018;
            public const ushort AI_Blank9 = 0x001A;
            public const ushort AI_Blank10 = 0x001C;
            public const ushort AI_Blank11 = 0x001E;

            public const ushort ZD_TestTime = 0x0020;
            public const ushort ZD = 0x0022;
            public const ushort AD_TestTime = 0x0024;
            public const ushort AD = 0x0026;
            public const ushort COD_TestTime = 0x0028;
            public const ushort COD = 0x002A;
            public const ushort ZL_TestTime = 0x002C;
            public const ushort ZL = 0x002E;
            public const ushort Blank1_TestTime = 0x0030;
            public const ushort Blank1 = 0x0032;
            public const ushort Blank2_TestTime = 0x0034;
            public const ushort Blank2 = 0x0036;
            public const ushort Blank3_TestTime = 0x0038;
            public const ushort Blank3 = 0x003A;
            public const ushort Blank4_TestTime = 0x003C;
            public const ushort Blank4 = 0x003E;
        }

        public Dictionary<ushort, byte[]> defalutValue = new Dictionary<ushort, byte[]>()
            {
                {Registers.AI_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 } },
                {Registers.AI_ZD, new byte[]{ 0,0,0,0 } },
                {Registers.AI_AD, new byte[]{ 0,0,0,0 }},
                {Registers.AI_COD, new byte[]{ 0,0,0,0 }},
                {Registers.AI_ZL, new byte[]{ 0,0,0,0 }},
                {Registers.AI_Blank1, new byte[]{ 0,0,0,0 }},
                {Registers.AI_Blank2,  new byte[]{ 0,0,0,0 }},
                {Registers.AI_Blank3, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank4, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank5, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank6, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank7, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank8, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank9, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank10, new byte[]{ 0,0,0,0 } },
                {Registers.AI_Blank11, new byte[]{ 0,0,0,0 } },
                {Registers.ZD_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.ZD, new byte[]{ 0,0,0,0 }},
                {Registers.AD_TestTime,new byte[]{ 0x00, 0x00, 0x00, 0x00 } },
                {Registers.AD, new byte[]{ 0,0,0,0 }},
                {Registers.COD_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.COD, new byte[]{ 0,0,0,0 }},
                {Registers.ZL_TestTime,new byte[]{ 0x00, 0x00, 0x00, 0x00 } },
                {Registers.ZL, new byte[]{ 0,0,0,0 }},
                {Registers.Blank1_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.Blank1, new byte[]{ 0,0,0,0 }},
                {Registers.Blank2_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.Blank2, new byte[]{ 0,0,0,0 }},
                {Registers.Blank3_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.Blank3, new byte[]{ 0,0,0,0 }},
                {Registers.Blank4_TestTime, new byte[]{ 0x00, 0x00, 0x00, 0x00 }},
                {Registers.Blank4, new byte[]{ 0,0,0,0 }}
            };

        public int MaxStartAddress = Registers.Blank4;   //最大的起始地址
        public int SlaveID
        {
            set
            {
                lock (_syncRoot)
                {
                    _portInfo.SlaveID = value;
                }
            }
            get
            {
                lock (_syncRoot)
                {
                    return _portInfo.SlaveID;
                }
            }
        }

        public AIMonitor()
        {
            _serialPort = new SerialPort();
            _serialPort.ReadTimeout = 500;
            _serialPort.WriteTimeout = 500;
            _portInfo = new PortInfo();
        }

        #region 订阅
        public void Subscription()
        {
            if (!_isSubscribed && DataReceivedHandler != null)
            {
                _serialPort.DataReceived += DataReceivedHandler;
                _isSubscribed = true;
            }
        }

        public void Unsubscription()
        {
            if (_isSubscribed && DataReceivedHandler != null)
            {
                _serialPort.DataReceived -= DataReceivedHandler;
                _isSubscribed = false;
            }
        }
        #endregion

        public bool Connect(string portName, int baudRate, Parity parity, StopBits stopBits, int dataBits, int slaveID)
        {
            try
            {
                _serialPort.PortName = portName;
                _serialPort.BaudRate = baudRate;
                _serialPort.Parity = (Parity)parity;
                _serialPort.StopBits = (StopBits)stopBits;
                _serialPort.DataBits = dataBits;

                _serialPort.Open();
                Task.Delay(2000).Wait();
                if (_serialPort.IsOpen)
                {
                    Subscription();
                    _portInfo.Name = portName;
                    _portInfo.BaudRate = baudRate;
                    _portInfo.Parity = parity;
                    _portInfo.StopBits = stopBits;
                    _portInfo.DataBits = dataBits;
                    _portInfo.SlaveID = slaveID;
                    return true;
                }
            }
            catch (Exception)
            {
                return false;
            }
            return false;
        }

        public bool Disconnect()
        {
            Unsubscription();
            _serialPort.Close();
            if (!_serialPort.IsOpen)
            {
                return true;
            }
            _serialPort.Dispose();
            return false;
        }

        //检查发送过来的命令是否有效
        public bool CheckDataIFValid(byte[] data)
        {
            uint i, j;
            uint crc16 = 0xFFFF;
            int count = data.Length;
            for (i = 0; i < count - 2; i++)
            {
                crc16 ^= data[i];
                for (j = 0; j < 8; j++)
                {
                    if ((crc16 & 0x0001) != 0)
                    {
                        crc16 >>= 1; // 右移一位
                        crc16 ^= 0xA001; // 异或多项式0xA001
                    }
                    else
                    {
                        crc16 >>= 1; // 右移一位
                    }
                }
            }
            byte highCRC = (byte)(crc16 & 0xFF);
            byte lowCRC = (byte)(crc16 >> 8);

            return (highCRC == data[count - 2]) && (lowCRC == data[count - 1]);
        }

        /// <summary>
        /// 为指令补全CRC16校验码，并返回完整指令
        /// </summary>
        /// <param name="hexCommand"></param>
        /// <returns></returns>
        public byte[] CalcCRC16(byte[] pBuf)
        {
            // MessageBox.Show(BitConverter.ToString(pBuf));
            int count = pBuf.Length + 2;
            byte[] command = new byte[count];
            uint i, j;
            uint crc16 = 0xFFFF;
            for (i = 0; i < pBuf.Length; i++)
            {
                command[i] = pBuf[i];
                crc16 ^= pBuf[i];
                for (j = 0; j < 8; j++)
                {
                    if ((crc16 & 0x0001) != 0)
                    {
                        crc16 >>= 1; // 右移一位
                        crc16 ^= 0xA001; // 异或多项式0xA001
                    }
                    else
                    {
                        crc16 >>= 1; // 右移一位
                    }
                }
            }
            command[count - 2] = (byte)(crc16 & 0xFF);
            command[count - 1] = (byte)(crc16 >> 8);
            return command;
        }

        //将浮点数值转为16进制
        /// <summary>
        /// 10-16大小端转换
        /// </summary>
        /// <param name="num"></param>
        /// <returns></returns>
        public byte[] FloatToHexMaxHead(float num)
        {
            byte[] bytes = BitConverter.GetBytes(num);
            // 检查当前平台是否为小端字节顺序,是的话，统一转为大端模式
            if (BitConverter.IsLittleEndian)
            {
                // 如果是小端字节顺序，反转字节数组
                Array.Reverse(bytes);
            }

            (bytes[0], bytes[2]) = (bytes[2], bytes[0]);  //交换索引0和2的位置
            (bytes[1], bytes[3]) = (bytes[3], bytes[1]);  //交换索引1和3的位置

            return bytes;
        }

        /// <summary>
        /// 时间转换为时间戳
        /// </summary>
        /// <param name="dt"></param>
        /// <returns></returns>
        public byte[] TimeToTimespanHex(DateTime dt)
        {
            DateTime utcDateTime = DateTime.SpecifyKind(dt, DateTimeKind.Utc);
            DateTime unixEpoch = new DateTime(2025, 1, 1, 0, 0, 0, DateTimeKind.Utc); // Unix纪元时间
            if (unixEpoch > dt)
            {
                return new byte[] { 0x00, 0x00, 0x00, 0x00 };
            }
            TimeSpan timeSpan = utcDateTime.ToUniversalTime() - unixEpoch;
            uint timeStamp = (uint)(timeSpan.Ticks / TimeSpan.TicksPerSecond);
            return new byte[] {
            (byte)(timeStamp >> 8),
            (byte)timeStamp,
            (byte)(timeStamp >> 24),
            (byte)(timeStamp >> 16)
            };
        }

        //将两字节的数组转为整型
        public ushort Convert16ToUInt16(byte[] data)
        {
            if (BitConverter.IsLittleEndian)
            {
                // 如果是小端字节顺序，反转字节数组
                Array.Reverse(data);
            }
            return BitConverter.ToUInt16(data, 0);
        }

        public void LockSend(byte[] sendData)
        {
            lock (_syncRoot)
            {
                if (!_serialPort.IsOpen)
                {
                    _serialPort.Open();
                }
                if (!_serialPort.IsOpen)
                {
                    throw new Exception($"{_portInfo.Name}串口未打开！");
                }
                //请空接收缓存区和发送缓存区
                _serialPort.DiscardInBuffer();
                _serialPort.DiscardOutBuffer();
                //发送指令
                _serialPort.Write(sendData, 0, sendData.Length);//发送数据
            }
        }

        //读取数据（带健壮性检查，防止空引用和无数据时异常）
        public byte[] ReadData(int delay = 100)
        {
            // 串口对象为空或已关闭时，直接返回空数组，避免触发 NullReferenceException
            if (_serialPort == null || !_serialPort.IsOpen)
            {
                return Array.Empty<byte>();
            }

            // 等待一定时间让数据到达
            Task.Delay(delay).Wait();

            int bytesToRead = _serialPort.BytesToRead;
            if (bytesToRead <= 0)
            {
                return Array.Empty<byte>();
            }

            byte[] buffer = new byte[bytesToRead];
            int actuallyRead = _serialPort.Read(buffer, 0, buffer.Length);

            // 理论上 read == bytesToRead，为安全起见做保护
            if (actuallyRead <= 0)
            {
                return Array.Empty<byte>();
            }

            if (actuallyRead != buffer.Length)
            {
                byte[] resized = new byte[actuallyRead];
                Array.Copy(buffer, resized, actuallyRead);
                return resized;
            }

            return buffer;
        }
    }
}

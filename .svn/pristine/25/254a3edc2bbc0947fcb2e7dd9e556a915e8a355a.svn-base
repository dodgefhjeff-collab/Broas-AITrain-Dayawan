        /// <summary>        /// Y5按钮点击事件 - 进样阀（硬件通道 Y5）
        /// </summary>
        private void Y5_Click(object sender, EventArgs e)
        {
            if (YStatus["Y5"] == "1")
                OperatorChannelMoreTimes(getCloseY5, 5, "进样阀", "关闭", "0");
            else
                OperatorChannelMoreTimes(getOpenY5, 5, "进样阀", "打开", "1");
        }


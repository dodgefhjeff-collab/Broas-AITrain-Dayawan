        /// <summary>
        /// 16 jin进制转浮点型
        /// </summary>
        /// <returns></returns>
        private float get16tofloat(string s)
        {
            float res = 0.00f;
            try
            {
                MatchCollection matches = Regex.Matches(s, @"[0-9A-Fa-f]{2}");
                byte[] bytes = new byte[matches.Count];
                for (int i = 0; i < bytes.Length; i++)
                    bytes[i] = byte.Parse(matches[i].Value, System.Globalization.NumberStyles.AllowHexSpecifier);
                res = BitConverter.ToSingle(bytes.Reverse().ToArray(), 0);
            }
            catch
            {
                res = 0.00f;
            }
            return res;
        }

        /// <summary>
        /// 日志信息写入 db（流程、报警、操作等统一用此方法）
        /// </summary>
        private void WriteLogDB(string source, string content)
        {
            _runAllLogInfoDto ??= RunAllLogInfoDto.GetInstance();
            _runAllLogInfoDto.LogContent = content;
            _runAllLogInfoDto.LogType = source;
            _runAllLogInfoDto.ReceivingTime = Convert.ToDateTime(DateTime.Now.ToString("G"));
            _runAllLogInfoDto.Addtime = Convert.ToDateTime(DateTime.Now.ToString("G"));
            _runAllLogInfoDto.UpdateTime = Convert.ToDateTime(DateTime.Now.ToString("G"));
            logHelper.AddRunAllLogInfo(_runAllLogInfoDto);
        }


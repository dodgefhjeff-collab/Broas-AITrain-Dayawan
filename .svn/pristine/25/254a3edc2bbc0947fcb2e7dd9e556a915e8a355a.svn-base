                                case 33:
                                    lbBaojingZL.Text = "参比电压异常";
                                    lbBaojingZL.ForeColor = Color.Red;
                                    if (ErrZL == 0)
                                    {
                                        ErrZL++;
                                        WriteLogDB("报警", "总磷参比电压异常");
                                    }
                                    break;
                                case 34:
                                    lbBaojingZL.Text = "串口通讯失败";
                                    lbBaojingZL.ForeColor = Color.Red;
                                    if (ErrZL == 0)
                                    {
                                        ErrZL++;
                                        WriteLogDB("报警", "总磷串口通讯失败");
                                    }
                                    break;
                            }
                            sZLStatus = workStatus.ToString();
                            sZLValue = baojing.ToString();
                        }
                    }
                }
            }
            catch (Exception e)
            {
                _logger.Error("AddDataHJ:" + e.Message);
                return;
            }
        }

        private void serialPort1_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                if (serialPort1.IsOpen)
                {
                    Thread.Sleep(50);
                    byte[] ReDatas = new byte[serialPort1.BytesToRead];
                    serialPort1.Read(ReDatas, 0, ReDatas.Length);//读取数据
                    this.AddData(ReDatas);//输出数据
                }
                else
                    MessageBox.Show("请先打开串口");
            }
            catch (Exception ex)
            {
                _logger.Error("控制板串口" + ex.Message);
                serialPort1.Close();
            }
        }

        /// <summary>
        /// 添加数据
        /// </summary>
        /// <param name="data"></param>
        public void AddData(byte[] data)
        {
            StringBuilder sb = new();
            for (int i = 0; i < data.Length; i++)
                sb.AppendFormat("{0:x2}" + " ", data[i]);
            AddContent(sb.ToString().ToUpper());
        }

        /// <summary>
        /// 控制板解析
        /// </summary>
        /// <param name="content"></param>
        private void AddContent(string content)
        {
            this.BeginInvoke(new MethodInvoker(delegate
            {
                //查询y00-y04  
                if (EquipmentValveCodeY0_27 == "Y0_27" && content.Length > 0)
                {
                    EquipmentValveCodeY0_27 = string.Empty;
                    var contentArrayInfo = content.Split(' ');
                    if (contentArrayInfo.Length == 7 && contentArrayInfo[1] == "01")
                    {
                        var hexBytecount = contentArrayInfo[2];//获取当前字节数
                        if (hexBytecount == "01")
                        {
                            var hexValue0_7 = contentArrayInfo[3];
                            var binaryValue0_7 = HexString2BinString(hexValue0_7);
                            for (int counter = 0; counter < binaryValue0_7.Length; counter++)
                            {
                                var temps = binaryValue0_7[counter].ToString();
                                if (counter == 0)
                                {
                                    YStatus["Y8"] = temps;
                                }
                                else if (counter == 1)
                                {
                                    YStatus["Y7"] = temps;
                                }
                                else if (counter == 2)
                                {
                                    YStatus["Y6"] = temps;
                                }
                                else if (counter == 3)
                                {
                                    if (temps == "0")
                                        this.Y5.FillColor = Color.Silver;
                                    else if (temps == "1")
                                        this.Y5.FillColor = Color.FromArgb(26, 101, 143);
                                    YStatus["Y5"] = temps;
                                }
                                else if (counter == 4)
                                {
                                    if (temps == "0")
                                        //y4灯灭
                                        this.Y4.FillColor = Color.Silver;
                                    else if (temps == "1")
                                        this.Y4.FillColor = Color.FromArgb(26, 101, 143);
                                    YStatus["Y4"] = temps;
                                }
                                else if (counter == 5)
                                {
                                    if (temps == "0")
                                        this.Y3.FillColor = Color.Silver;
                                    else if (temps == "1")
                                        this.Y3.FillColor = Color.FromArgb(26, 101, 143);
                                    YStatus["Y3"] = temps;
                                }
                                else if (counter == 6)
                                {
                                    YStatus["Y2"] = temps;
                                }
                                else if (counter == 7)
                                {
                                    if (temps == "0")
                                        //y1灯灭
                                        this.Y1.FillColor = Color.Silver;
                                    else if (temps == "1")
                                        this.Y1.FillColor = Color.FromArgb(26, 101, 143);
                                    YStatus["Y1"] = temps;
                                }
                            }
                        }
                    }
                }
                if (EquipmentValveCodeX0_17 == "X0_17" && content.Length > 0)
                {
                    EquipmentValveCodeX0_17 = string.Empty;
                    var contentArrayInfo = content.Split(' ');
                    if (contentArrayInfo.Length == 7 && contentArrayInfo[1] == "02")
                    {
                        if (contentArrayInfo[2] == "01")
                        {
                            var hexValue = contentArrayInfo[3];
                            var binaryValue = HexString2BinString(hexValue);

                            // 处理X1（位7，从右往左数第1位）
                            if (binaryValue.Length > 7)
                            {
                                var x1Temp = binaryValue[7].ToString();
                                if (x1Temp == "1")
                                {
                                    btnYWJ.FillColor = Color.FromArgb(26, 101, 143);

                                }
                                else
                                {
                                    btnYWJ.FillColor = Color.Silver;

                                }
                                X1Value = x1Temp;
                            }

                            // 处理X2（位6，从右往左数第2位）- AI液位
                            if (binaryValue.Length > 6)
                            {
                                var x2Temp = binaryValue[6].ToString();
                                if (x2Temp == "1")
                                    btnAIYWJ.FillColor = Color.FromArgb(26, 101, 143);
                                else
                                    btnAIYWJ.FillColor = Color.Silver;
                                X2Value = x2Temp;
                            }
                        }
                    }
                }
            }));
        }

        /// <summary>
        /// AI接收
        /// </summary>
        /// <param name="content"></param>
        private void serialPortAI_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                if (serialPortAI.IsOpen)
                {
                    Delay(600);
                    byte[] ReDatas = new byte[serialPortAI.BytesToRead];
                    serialPortAI.Read(ReDatas, 0, ReDatas.Length);//读取数据
                    serialPortAI.DiscardInBuffer();
                    this.AddDataAI(ReDatas);//输出数据                                    
                }
                else
                    _logger.Error("请先打开AI串口");
            }
            catch (Exception ex)
            {
                _logger.Error("serialPortAI_DataReceived" + ex.Message);
                serialPortAI.Close();
            }
        }

        private void AddDataAI(byte[] data)
        {
            StringBuilder sb = new();
            for (int i = 0; i < data.Length; i++)
                sb.AppendFormat("{0:x2}" + " ", data[i]);
            string content = sb.ToString().ToUpper();
            _logger.Debug("AI接收数据:" + content);
            this.BeginInvoke(new MethodInvoker(delegate
            {
                if (content.Contains(" "))
                {
                    var contentArray = content.Split(' ');
                      _logger.Debug("AI接收数据:" + contentArray.Length);
                    if (contentArray.Length == 1346)
                    {
                        var codVal = contentArray[6] + contentArray[5] + contentArray[4] + contentArray[3];
                        var codValue = Convert.ToDecimal(Math.Round(get16tofloat(codVal), 3));
                        Global.YSRecentValCOD = codValue;
                        var codmnVal = contentArray[10] + contentArray[9] + contentArray[8] + contentArray[7];
                        var codmnValue = Convert.ToDecimal(Math.Round(get16tofloat(codmnVal), 3));
                        Global.YSRecentValXS = codmnValue;
                        var zdVal = contentArray[14] + contentArray[13] + contentArray[12] + contentArray[11];
                        var zdValue = Convert.ToDecimal(Math.Round(get16tofloat(zdVal), 3));
                        Global.YSRecentValZD = zdValue;
                        var adVal = contentArray[18] + contentArray[17] + contentArray[16] + contentArray[15];
                        var adValue = Convert.ToDecimal(Math.Round(get16tofloat(adVal), 3));
                        Global.YSRecentValAD = adValue;
                        var zlVal = contentArray[22] + contentArray[21] + contentArray[20] + contentArray[19];
                        var zlValue = Convert.ToDecimal(Math.Round(get16tofloat(zlVal), 3));
                        Global.YSRecentValZL = zlValue;
                        var ZhuoduVal = contentArray[26] + contentArray[25] + contentArray[24] + contentArray[23];
                        var zhuoduValue = Convert.ToDecimal(Math.Round(get16tofloat(ZhuoduVal), 3));
                        Global.YSRecentValZhuodu = zhuoduValue;
                        if (ZDVal != zdValue.ToString())
                        {
                            ZDVal = zdValue.ToString();
                            var ctTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:00");
                            Global.RecentValZD = Global.YSRecentValZD;
                            Global.RecentValAD = Global.YSRecentValAD;
                            Global.RecentValCOD = Global.YSRecentValCOD;
                            Global.RecentValZL = Global.YSRecentValZL;
                            Global.RecentValXS = Global.YSRecentValXS;
                            Global.RecentValZhuodu = Global.YSRecentValZhuodu;
                            Task.Run(async () =>
                            {
                                MeasureData a = new()
                                {
                                    ID = Math.Abs(_Snowflake.GetId()),
                                    DataType = "AI周期数据",
                                    CollectTime = DateTime.Parse(ctTime),
                                    TotalNitrogenVal = Global.RecentValZD,
                                    AmmoniaADValue = Global.RecentValAD,
                                    TotalCODVal = Global.RecentValCOD,
                                    TotalPhosphorusVal = Global.RecentValZL,
                                    XSYDVal = Global.RecentValXS,
                                    TurbidityVal = Global.RecentValZhuodu,
                                };
                                await DataAPI.AddMeasureDataAsync(a);
                            });
                            string re = string.Empty;
                            string uploadxgd = string.Empty;
                            double xgdTN1 = 0, xgdCOD1 = 0, xgdTN2 = 0, xgdCOD2 = 0;
                            for (int i = 0; i < 325; i++)
                            {
                                var x = contentArray[46 + 4 * i] + contentArray[45 + 4 * i] + contentArray[44 + 4 * i] + contentArray[43 + 4 * i];
                                var y = Math.Round(get16tofloat(x), 3);
                                re += y.ToString() + ";";
                                uploadxgd += "B" + i + "=" + y + ",";
                                if (i == 29)
                                    xgdTN1 = y;
                                if (i == 44)
                                    xgdTN2 = y;
                                if (i == 53)
                                    xgdCOD1 = y;
                                if (i == 109)
                                    xgdCOD2 = y;
                            }
                            AllXGD = re;
                            UploadXGD = uploadxgd;
                            txtCurrentValCOD.Text = Math.Round(xgdCOD1 - xgdCOD2, 3).ToString();
                            txtCurrentValTN.Text = Math.Round(xgdTN1 - xgdTN2, 3).ToString();
                        }
                    }
                    else if (contentArray.Length == 54)
                    {
                        var xgdValCOD1 = contentArray[6] + contentArray[5] + contentArray[4] + contentArray[3];
                        txtAIXGD_COD1.Text = Math.Round(get16tofloat(xgdValCOD1), 3).ToString();
                        var xgdValCOD2 = contentArray[10] + contentArray[9] + contentArray[8] + contentArray[7];
                        txtAIXGD_COD2.Text = Math.Round(get16tofloat(xgdValCOD2), 3).ToString();
                        var xgdValCOD3 = contentArray[14] + contentArray[13] + contentArray[12] + contentArray[11];
                        txtAIXGD_COD3.Text = Math.Round(get16tofloat(xgdValCOD3), 3).ToString();
                        var kValCOD = contentArray[18] + contentArray[17] + contentArray[16] + contentArray[15];
                        txtAIKVal_COD.Text = Math.Round(get16tofloat(kValCOD), 3).ToString();
                        var bValCOD = contentArray[22] + contentArray[21] + contentArray[20] + contentArray[19];
                        txtAIBVal_COD.Text = Math.Round(get16tofloat(bValCOD), 3).ToString();
                        var xgdValTN1 = contentArray[34] + contentArray[33] + contentArray[32] + contentArray[31];
                        txtAIXGD_TN1.Text = Math.Round(get16tofloat(xgdValTN1), 3).ToString();
                        var xgdValTN2 = contentArray[38] + contentArray[37] + contentArray[36] + contentArray[35];
                        txtAIXGD_TN2.Text = Math.Round(get16tofloat(xgdValTN2), 3).ToString();
                        var xgdValTN3 = contentArray[42] + contentArray[41] + contentArray[40] + contentArray[39];
                        txtAIXGD_TN3.Text = Math.Round(get16tofloat(xgdValTN3), 3).ToString();
                        var kValTN = contentArray[46] + contentArray[45] + contentArray[44] + contentArray[43];
                        txtAIKVal_TN.Text = Math.Round(get16tofloat(kValTN), 3).ToString();
                        var bValTN = contentArray[50] + contentArray[49] + contentArray[48] + contentArray[47];
                        txtAIBVal_TN.Text = Math.Round(get16tofloat(bValTN), 3).ToString();
                    }
                    else if (contentArray.Length == 14)  //查询测试周期和清洗周期回读理应：01 03 08 00 05 00 00 00 00 00 3C A4 54
                    {
                        //var sTime = contentArray[9] + contentArray[10];
                        //var cycTime = To16Convert10(sTime);
                        txtCleanCycle.Text = To16Convert10($"{contentArray[3]}{contentArray[4]}").ToString();
                        txtTextCycle.Text = To16Convert10($"{contentArray[9]}{contentArray[10]}").ToString();
                        ShowTip.ShowSuccessTip("读取测试周期和清洗周期成功！");
                    }
                    else if (contentArray.Length == 8)  //AI报警获取
                    {
                        if (AiStatus == "yes")
                        {
                            AiStatus = string.Empty;
                            if (contentArray[4] == "02")
                                btnAI.FillColor = Color.FromArgb(26, 101, 143);
                            else if (contentArray[4] == "00")
                                btnAI.FillColor = Color.Silver;
                            AiStatusVal = contentArray[4];
                        }
                        if (AiWarn == "yes")
                        {
                            AiWarn = string.Empty;
                            if (data[4] != 0x00)  //报警清零后，若还报警就记录
                            {
                                SendAIData(strToHexByte("01 06 06 94 00 00 C8 AE"));
                                Global.IsAIAlarm = "1";
                                //string binary = Convert.ToString(data[4], 2).PadLeft(8, '0');
                                ////WriteLogDB("报警", $"AI传感器异常：{string.Format("{0},{1},{2},{3}", binary[4] == '1' ? _AIAlarmSet[4] : "", binary[5] == '1' ? _AIAlarmSet[5] : "", binary[6] == '1' ? _AIAlarmSet[6] : "", binary[7] == '1' ? _AIAlarmSet[7] : "")}");
                                //for (int i = 0; i < 5; i++)
                                //{
                                //    if (SendAIData(strToHexByte("01 06 06 94 00 00 C8 AE")))  //AI报警复位
                                //        break;
                                //}
                            }
                        }
                    }
                    else if (contentArray.Length == 9 && data[3] != 0x94)
                        ShowTip.ShowSuccessTip("设置成功!");
                }
            }));
        }

        /// <summary>
        /// 发送数据
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        public bool SendData(byte[] data)
        {
            lock (objLock1)
            {
                if (serialPort1.IsOpen)
                    try
                    {
                        serialPort1.Write(data, 0, data.Length);//发送数据
                        return true;
                    }
                    catch (Exception e)
                    {
                        _logger.Error("SendData" + e.Message);
                        serialPort1.Close();
                    }
                else
                    _logger.Error("串口未打开");
                return false;
            }
        }

        private string stringTo16String(string value)
        {
            var a = ushort.Parse(value);
            byte high = (byte)(a >> 8);
            byte low = (byte)(a & 0xFF);
            return $"{high:X2} {low:X2}";
        }

        private int To16Convert10(string str)
        {
            int res = 0;
            try
            {
                str = str.Trim().Replace(" ", "");//移除空字符
                //方法1
                res = int.Parse(str, System.Globalization.NumberStyles.AllowHexSpecifier);
            }
            catch
            {
                res = 0;
            }
            return res;
        }

        /// <summary>
        /// 字符串转换16进制字节数组
        /// </summary>
        /// <param name="hexString"></param>
        /// <returns></returns>
        private byte[] strToHexByte(string hexString)
        {
            hexString = hexString.Replace(" ", "");
            if ((hexString.Length % 2) != 0)
                hexString += " ";
            byte[] returnBytes = new byte[hexString.Length / 2];
            for (int i = 0; i < returnBytes.Length; i++)
                returnBytes[i] = Convert.ToByte(hexString.Substring(i * 2, 2).Replace(" ", ""), 16);
            return returnBytes;
        }

        private void InitQCRecentValTime()
        {
            const string defaultTime = "2024-10-10 10:00:00";
            zkTimeZD1 = GetOrAddAppSetting("byRecentValTimeZD", defaultTime);
            zkTimeAD1 = GetOrAddAppSetting("byRecentValTimeAD", defaultTime);
            zkTimeCOD1 = GetOrAddAppSetting("byRecentValTimeCOD", defaultTime);
            zkTimeZL1 = GetOrAddAppSetting("byRecentValTimeZL", defaultTime);
            zkTimeZD2 = GetOrAddAppSetting("ldRecentValTimeZD", defaultTime);
            zkTimeAD2 = GetOrAddAppSetting("ldRecentValTimeAD", defaultTime);
            zkTimeCOD2 = GetOrAddAppSetting("ldRecentValTimeCOD", defaultTime);
            zkTimeZL2 = GetOrAddAppSetting("ldRecentValTimeZL", defaultTime);
            if (configuration.AppSettings.Settings["DataCount"] == null)
            {
                configuration.AppSettings.Settings.Add("DataCount", "3");
                configuration.Save(ConfigurationSaveMode.Modified);
            }
        }

        private string GetOrAddAppSetting(string key, string defaultValue)
        {
            if (configuration.AppSettings.Settings[key] == null)
            {
                configuration.AppSettings.Settings.Add(key, defaultValue);
                configuration.Save(ConfigurationSaveMode.Modified);
                return defaultValue;
            }
            return configuration.AppSettings.Settings[key].Value;
        }

        private int GetDataCount()
        {
            if (int.TryParse(configuration.AppSettings.Settings["DataCount"]?.Value, out int count))
                return count;
            return 3;
        }

        private void ProcessQCRecords(string[] data, string testTimeBY, decimal testValueBY, string testTimeLD, decimal testValueLD)
        {
            switch (data[0])
            {
                case "01":
                    TryInsertQCRecord(data, testTimeBY, testValueBY, "1", 36, 37, ref zkTimeZD1, "byRecentValTimeZD", "总氮");
                    TryInsertQCRecord(data, testTimeLD, testValueLD, "2", 80, 81, ref zkTimeZD2, "ldRecentValTimeZD", "总氮");
                    break;
                case "02":
                    TryInsertQCRecord(data, testTimeBY, testValueBY, "1", 36, 37, ref zkTimeAD1, "byRecentValTimeAD", "氨氮");
                    TryInsertQCRecord(data, testTimeLD, testValueLD, "2", 80, 81, ref zkTimeAD2, "ldRecentValTimeAD", "氨氮");
                    break;
                case "03":
                    TryInsertQCRecord(data, testTimeBY, testValueBY, "1", 36, 37, ref zkTimeCOD1, "byRecentValTimeCOD", "COD");
                    TryInsertQCRecord(data, testTimeLD, testValueLD, "2", 80, 81, ref zkTimeCOD2, "ldRecentValTimeCOD", "COD");
                    break;
                case "04":
                    TryInsertQCRecord(data, testTimeBY, testValueBY, "1", 36, 37, ref zkTimeZL1, "byRecentValTimeZL", "总磷");
                    TryInsertQCRecord(data, testTimeLD, testValueLD, "2", 80, 81, ref zkTimeZL2, "ldRecentValTimeZL", "总磷");
                    break;
            }
        }

        private void TryInsertQCRecord(string[] data, string testTime, decimal testValue, string remarkType,
            int monthIndex, int dayIndex, ref string zkTime, string configKey, string factorName)
        {
            if (!int.TryParse(data[monthIndex], out int month) || !int.TryParse(data[dayIndex], out int day))
                return;
            if (month <= 0 || day <= 0)
                return;
            if (zkTime == testTime)
                return;

            InsertQCRecord(testTime, factorName, (double)testValue, remarkType);
            zkTime = testTime;
            configuration.AppSettings.Settings[configKey].Value = testTime;
            configuration.Save(ConfigurationSaveMode.Modified);
        }

        /// <summary>
        /// 插入质控记录
        /// </summary>
        private void InsertQCRecord(string startTime, string sName, double testval, string type)
        {
            try
            {
                QCRecord record = new()
                {
                    ID = Math.Abs(_Snowflake.GetId()),
                    QCName = sName,
                    QCTime = DateTime.Parse(startTime),
                    LiuliangVal = (decimal)testval,
                    Remark = type
                };
                DataAPI.AddQCData(record);
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "插入质控数据报错");
            }
        }


        private async void btn1Start_Click(object sender, EventArgs e)
        {
            string runMode = comBoxRunMode.Text?.Trim() ?? "训练模式";
            WriteLogDB("操作", $"启动流程（{runMode}）");
            SetFlowAutoRestart(true);
            await StartFlowAsync();
        }

        private async Task StartFlowAsync()
        {
            StopAutoTest();

            if (!timerLiucheng.Enabled)
            {
                if (int.TryParse(txtZQTime.Text?.Trim(), out int cycleTime) && cycleTime > 0)
                    timerLiucheng.Interval = cycleTime * 60000;
                else
                    timerLiucheng.Interval = 60 * 60000;
                timerLiucheng.Start();
            }

            cts?.Cancel();
            cts = new();

            string runMode = comBoxRunMode.Text?.Trim() ?? "训练模式";
            if (runMode == "推理模式")
                await AutoInferenceMode();
            else
                await AutoHuanshui();
        }

        private byte[] HexStringToByteArray(string hexString)
        {
            hexString = hexString.Replace(" ", "").Replace("-", "").ToUpper().Trim();
            if (hexString.Length % 2 != 0)
                hexString += " ";
            int bytesCount = hexString.Length / 2;
            byte[] bytes = new byte[bytesCount];
            for (int i = 0; i < bytesCount; i++)
            {
                string byteString = hexString.Substring(i * 2, 2);
                bytes[i] = Convert.ToByte(byteString, 16);
            }
            return bytes;
        }



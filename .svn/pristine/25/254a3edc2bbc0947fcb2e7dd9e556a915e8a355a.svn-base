        private void btnStartZD_Click(object sender, EventArgs e)
        {
            string strSendAd = "01 10 12 00 00 01 02 00 01";
            try
            {
                if (!serialPortHJ.IsOpen)
                    serialPortHJ.Open();
                var sendData2 = strToHexByte(CalcCRC16(strSendAd));
                SendYBData(sendData2);//发送数据;
                WriteLogDB("操作", "总氮启动测量");
            }
            catch (Exception ex)
            {
                _logger.Error("总氮" + ex.Message);
                return;
            }
        }


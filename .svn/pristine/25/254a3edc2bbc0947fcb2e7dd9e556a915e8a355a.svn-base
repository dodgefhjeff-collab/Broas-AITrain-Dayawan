        /// 环境hj212 协议
        /// </summary>
        /// <param name="Mode"></param>
        /// <returns></returns>
        public static string GetBackCmd(string Mode)
        {
            string strHead = "##";
            string strlen = "";
            string strMode = Mode;
            strlen = strMode.Length.ToString("0000");
            strMode = strHead + strlen + strMode + HJ212Mode.Crc_16(strMode) + "\r\n";
            return strMode;
        }


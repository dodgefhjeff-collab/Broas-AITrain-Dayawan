            WriteLogDB("操作", "强制结束流程");
        }

        private void btnSettingAI_Click(object sender, EventArgs e)
        {
            string cd = "00 00";
            string cd2 = "00 01";
            if (comBoxMode.Text.ToString().Trim() == "AI")
                cd = "00 00";
            else if (comBoxMode.Text.ToString().Trim() == "普通")
                cd = "00 01";
            string modeCmd = "01 06 06 92" + cd;
            SendAIData(strToHexByte(CalcCRC16(modeCmd).Trim()));
            Delay(200);
            if (comBoxFactor.Text.ToString().Trim() == "COD")
                cd2 = "00 01";
            else if (comBoxFactor.Text.ToString().Trim() == "TN")
                cd2 = "00 02";
            string factorCmd = "01 06 06 95" + cd2;
            SendAIData(strToHexByte(CalcCRC16(factorCmd).Trim()));
            WriteLogDB("操作", "设置模式和因子");
        }

        /// <summary>
        /// CRC16验证
        /// </summary>
        /// <param name="hexCommand"></param>
        /// <returns>string</returns>
        private string CalcCRC16(string hexCommand)
        {
            byte[] pBuf = HexStringToByteArray(hexCommand);
            uint i, j;
            uint crc16 = 0xFFFF;
            for (i = 0; i < pBuf.Length; i++)
            {
                crc16 ^= pBuf[i];
                for (j = 0; j < 8; j++)
                {
                    if ((crc16 & 0x0001) != 0)
                    {
                        crc16 >>= 1; // 右移一位
                        crc16 ^= 0xA001; // 异或多项式0xA001
                    }
                    else
                        crc16 >>= 1; // 右移一位
                }
            }
            string crcDefLow1 = Convert.ToString((byte)(crc16 & 0xFF), 16).PadLeft(2, '0');
            string crcDefHigh1 = Convert.ToString((byte)(crc16 >> 8), 16).PadLeft(2, '0');
            return hexCommand + crcDefLow1 + crcDefHigh1;
        }

        private void btnSearchAI_Click(object sender, EventArgs e)
        {
            //查询测试周期  "01 03 00 08 00 01 05 C8"
            //查询清洗周期  "01 03 00 05 00 01 94 0B"
            //合成一条指令查找
            string cmd = "01 03 00 05 00 04 54 08";  //回读：01 03 08 00 01 00 05 00 50 00 3C 49 17 
            SendAIData(strToHexByte(cmd));
        }

        private void btnAITestCycleSetting_Click(object sender, EventArgs e)
        {
            if (!string.IsNullOrEmpty(txtTextCycle.Text.Trim()))
            {
                string cmd = "01 06 00 08" + stringTo16String(txtTextCycle.Text.Trim());
                SendAIData(strToHexByte(CalcCRC16(cmd).Trim()));
                WriteLogDB("操作", "设置测试周期");
            }
        }

        private void btnAICleanSetting_Click(object sender, EventArgs e)
        {
            if (ushort.TryParse(txtCleanCycle.Text.Trim(), out ushort cycle))
            {
                if (cycle > 255)
                {
                    ShowTip.ShowErrorTip("请输入255以内的循环周期！");
                    return;
                }
                string cmd = "01 06 00 05" + stringTo16String(txtCleanCycle.Text.Trim());
                SendAIData(strToHexByte(CalcCRC16(cmd).Trim()));
                WriteLogDB("操作", "设置清洗周期");
            }
        }

        private void btnAICheckCOD1_Click(object sender, EventArgs e)
        {
            if (!string.IsNullOrEmpty(txtAINongdu_COD1.Text.Trim()))
            {
                if (txtAINongdu_COD1.Text.Trim() == "0")
                {
                    string cmd = "01 10 06 86 00 02 04 00 01 00 00 01 85";
                    SendAIData(strToHexByte(cmd));
                }
                else
                {
                    string cmd = string.Format("01 10 06 86 00 02 04 {0} {1}", "00 01", stringTo16String(txtAINongdu_COD1.Text.Trim()));
                    SendAIData(strToHexByte(CalcCRC16(cmd).Trim()));
                }
                WriteLogDB("操作", "COD标1标定");
                ShowTip.ShowSuccessTip("标定成功");
            }
        }


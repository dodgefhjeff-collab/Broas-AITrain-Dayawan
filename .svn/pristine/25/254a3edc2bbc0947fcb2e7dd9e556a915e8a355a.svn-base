                var sendData2 = strToHexByte(CalcCRC16(strSendAd));
                SendYBData(sendData2);//发送数据;
                WriteLogDB("操作", "COD零点校准");
            }
            catch (Exception ex)
            {
                _logger.Error("COD" + ex.Message);
                return;
            }
        }


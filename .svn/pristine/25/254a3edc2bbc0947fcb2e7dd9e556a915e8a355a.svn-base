        #region AI监测仪作为从站的相关方法
        private void AISlaveInit()
        {
            cBoxPort.Items.AddRange(SerialPort.GetPortNames());
            //放入1-247的数值
            cBoxStation.Items.AddRange(Enumerable.Range(1, 247).Select(i => i.ToString()).ToArray());
            cBoxStation.SelectedIndex = 0;
            cBoxCheckBits.Items.AddRange(Enum.GetNames(typeof(Parity)));
            cBoxStopbits.Items.AddRange(Enum.GetNames(typeof(StopBits)));

            AddNewKeyToConfig();

            AISlave = new AIMonitor();
            AISlave.DataReceivedHandler = new SerialDataReceivedEventHandler(AISlaveDataReceived);
            //从配置文件中获取各种参数配置
            PortInfo info = GetPortInfo(ConfigurationManager.AppSettings["Port"], ConfigurationManager.AppSettings["BaudRate"], ConfigurationManager.AppSettings["Parity"], ConfigurationManager.AppSettings["StopBits"], ConfigurationManager.AppSettings["DataBits"], ConfigurationManager.AppSettings["StationNo"]);
            cBoxPort.SelectedItem = ConfigurationManager.AppSettings["Port"];
            cBoxBaud.SelectedItem = ConfigurationManager.AppSettings["BaudRate"];
            cBoxCheckBits.SelectedItem = ConfigurationManager.AppSettings["Parity"];
            cBoxStopbits.SelectedItem = ConfigurationManager.AppSettings["StopBits"];
            cBoxDataBits.SelectedItem = ConfigurationManager.AppSettings["DataBits"];
            cBoxStation.SelectedItem = ConfigurationManager.AppSettings["StationNo"];
            if (bool.TryParse(ConfigurationManager.AppSettings["IsAutoConnectSlave"], out bool isConnect))
            {
                if (isConnect)
                {
                    AISlave.Connect(info.Name, info.BaudRate, info.Parity, info.StopBits, info.DataBits, info.SlaveID);
                }
            }
            //如果状态为真，则连接
            if (AISlave.IsOpen)
            {
                btnConnect.Text = "已连接";
                btnConnect.FillColor = Color.FromArgb(26, 101, 143);
                _logger.Info("从站串口连接成功");
            }
        }

        private PortInfo GetPortInfo(string port, string baudRate, string parity, string stopBits, string dataBits, string slaveID)
        {
            try
            {
                PortInfo portInfo = new PortInfo();
                portInfo.Name = port;
                portInfo.BaudRate = int.Parse(baudRate);
                portInfo.Parity = (Parity)Enum.Parse(typeof(Parity), parity);
                portInfo.StopBits = (StopBits)Enum.Parse(typeof(StopBits), stopBits);
                portInfo.DataBits = int.Parse(dataBits);
                portInfo.SlaveID = int.Parse(slaveID);
                return portInfo;
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message, "错误", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return null;
            }
        }

        private void AddNewKeyToConfig()
        {
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("IsAutoConnectSlave"))
            {
                configuration.AppSettings.Settings.Add("IsAutoConnectSlave", "false");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("Port"))
            {
                configuration.AppSettings.Settings.Add("Port", "COM1");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("BaudRate"))
            {
                configuration.AppSettings.Settings.Add("BaudRate", "9600");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("DataBits"))
            {
                configuration.AppSettings.Settings.Add("DataBits", "8");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("StopBits"))
            {
                configuration.AppSettings.Settings.Add("StopBits", "One");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("Parity"))
            {
                configuration.AppSettings.Settings.Add("Parity", "None");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains("StationNo"))
            {
                configuration.AppSettings.Settings.Add("StationNo", "1");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
            if (!ConfigurationManager.AppSettings.AllKeys.Contains(FlowAutoRestartKey))
            {
                configuration.AppSettings.Settings.Add(FlowAutoRestartKey, "N");
                configuration.Save(ConfigurationSaveMode.Modified);
                ConfigurationManager.RefreshSection("appSettings");
            }
        }

        private bool IsFlowAutoRestartEnabled()
        {
            ConfigurationManager.RefreshSection("appSettings");
            return string.Equals(ConfigurationManager.AppSettings[FlowAutoRestartKey], "Y", StringComparison.OrdinalIgnoreCase);
        }

        private void SetFlowAutoRestart(bool enabled)
        {
            string value = enabled ? "Y" : "N";
            if (configuration.AppSettings.Settings[FlowAutoRestartKey] == null)
                configuration.AppSettings.Settings.Add(FlowAutoRestartKey, value);
            else
                configuration.AppSettings.Settings[FlowAutoRestartKey].Value = value;
            configuration.Save(ConfigurationSaveMode.Modified);
            ConfigurationManager.RefreshSection("appSettings");
        }

        private void AISlaveDataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                if (AISlave == null || !AISlave.IsOpen)
                {
                    logHelper.WriteLogInfo("AISlaveDataReceived 触发时串口未打开或对象为空，忽略本次数据。", "data-监测仪接收数据");
                    return;
                }

                byte[] data = AISlave.ReadData();

                // 防御性检查，避免 data 为空或长度不足导致 NullReferenceException / IndexOutOfRangeException
                if (data == null || data.Length < 6)
                {
                    logHelper.WriteLogInfo("AISlaveDataReceived 收到的数据为空或长度过短，忽略本次数据。", "data-监测仪接收数据");
                    return;
                }

                logHelper.WriteLogInfo($"接收到的数据：{BitConverter.ToString(data).Replace("-", " ")}", "data-监测仪接收数据");
#if DEBUG
                MessageBox.Show(BitConverter.ToString(data).Replace("-", " "));
#endif
                //01 04 00 00 00 10 F1 C6
                //回读功能码04
                bool isNormal = true;
                byte errorType = 0;
                List<byte> list = new List<byte>();
                if (data[0] == AISlave.SlaveID)
                {
                    ushort count = AISlave.Convert16ToUInt16(new byte[] { data[4], data[5] });
                    ushort startAddress = AISlave.Convert16ToUInt16(new byte[] { data[2], data[3] });
                    if (data[1] != 0x04)
                    {
                        logHelper.WriteLogInfo("接收的功能码有误！", "data-监测仪接收数据");
                        errorType = 1;
                        isNormal = false;
                    }
                    if (!AISlave.CheckDataIFValid(data))
                    {
                        logHelper.WriteLogInfo("接收的CRC有误！", "data-监测仪接收数据");
                        errorType = 4;
                        isNormal = false;
                    }
                    if (count == 0)
                    {
                        logHelper.WriteLogInfo("读取寄存器个数为0！", "data-监测仪接收数据");  //回读一个错误的
                        errorType = 3;
                        isNormal = false;
                    }
                    if (startAddress > AISlave.MaxStartAddress)
                    {
                        logHelper.WriteLogInfo("超出协议寄存器最大起始地址！", "data-监测仪接收数据");
                        errorType = 2;
                        isNormal = false;
                    }
                    if (isNormal)
                    {
                        list.AddRange(new byte[] { data[0], data[1], (byte)(count * 2) });
#if DEBUG
                        AISlave.defalutValue[Registers.AI_ZD] = AISlave.FloatToHexMaxHead(4.965f);
                        AISlave.defalutValue[Registers.AI_AD] = AISlave.FloatToHexMaxHead(6.589f);
                        AISlave.defalutValue[Registers.AI_COD] = AISlave.FloatToHexMaxHead(8.595f);
                        AISlave.defalutValue[Registers.AI_ZL] = AISlave.FloatToHexMaxHead(0.256f);
                        AISlave.defalutValue[Registers.ZD_TestTime] = AISlave.TimeToTimespanHex(DateTime.Parse("2025-01-02 00:00:00"));
                        AISlave.defalutValue[Registers.ZD] = AISlave.FloatToHexMaxHead(23.695f);
                        AISlave.defalutValue[Registers.AD] = AISlave.FloatToHexMaxHead(125.692f);
                        AISlave.defalutValue[Registers.COD] = AISlave.FloatToHexMaxHead(635.2f);
                        AISlave.defalutValue[Registers.ZL] = AISlave.FloatToHexMaxHead(5.789f);
#else
                        AISlave.defalutValue[Registers.AI_TestTime] = AISlave.TimeToTimespanHex(DateTime.Now);
                        AISlave.defalutValue[Registers.AI_ZD] = AISlave.FloatToHexMaxHead((float)Global.RecentValZD);
                        AISlave.defalutValue[Registers.AI_AD] = AISlave.FloatToHexMaxHead((float)Global.RecentValAD);
                        AISlave.defalutValue[Registers.AI_COD] = AISlave.FloatToHexMaxHead((float)Global.RecentValCOD);
                        AISlave.defalutValue[Registers.AI_ZL] = AISlave.FloatToHexMaxHead((float)Global.RecentValZL);
                        if (Global.EQNames.Contains("总氮"))
                        {
                            if (DateTime.TryParse(Global.RecentValTimeZD, out DateTime zdTime))
                            {
                                AISlave.defalutValue[Registers.ZD_TestTime] = AISlave.TimeToTimespanHex(zdTime);
                            }
                            AISlave.defalutValue[Registers.ZD] = AISlave.FloatToHexMaxHead((float)Global.YBRecentValZD);
                        }
                        if (Global.EQNames.Contains("氨氮"))
                        {
                            if (DateTime.TryParse(Global.RecentValTimeAD, out DateTime adTime))
                            {
                                AISlave.defalutValue[Registers.AD_TestTime] = AISlave.TimeToTimespanHex(adTime);
                            }
                            AISlave.defalutValue[Registers.AD] = AISlave.FloatToHexMaxHead((float)Global.YBRecentValAD);
                        }

#endif
                        List<ushort> keys = AISlave.defalutValue.Keys.ToList();
                        for (int i = 0; i < keys.Count; i++)
                        {
                            //这种是地址在字典key中
                            if (keys[i] == startAddress)
                            {
                                //计算最大可获取的寄存器个数，如果超过寄存器范围，剩下的由0填充
                                int readableCountMax = keys.Count * 2 - i * 2;
                                if (count <= readableCountMax)
                                {
                                    //如果为偶数
                                    if (count % 2 == 0)
                                    {
                                        for (int j = i; j < count / 2 + i; j++)
                                        {
                                            list.AddRange(AISlave.defalutValue[keys[j]]);
                                        }
                                    }
                                    else
                                    {
                                        int j = i;
                                        for (; j < (count - 1) / 2; j++)
                                        {
                                            list.AddRange(AISlave.defalutValue[keys[j]]);
                                        }
                                        list.Add(AISlave.defalutValue[keys[j]][0]);
                                        list.Add(AISlave.defalutValue[keys[j]][1]);
                                    }
                                }
                                else
                                {
                                    //先填充有效寄存器数值
                                    for (int j = i; j < keys.Count; j++)
                                    {
                                        list.AddRange(AISlave.defalutValue[keys[j]]);
                                    }
                                    //剩余的用0填充
                                    for (int j = 1; j <= count - (keys.Count - i) * 2; j++)
                                    {
                                        list.AddRange(new byte[] { 0x00, 0x00 });
                                    }
                                }
                                break;
                            }
                            else
                            {
                                //不在字典中，则要看看在不在字典Key减一的范围内，在的话就处理
                                if (keys[i] == startAddress - 1)
                                {
                                    //计算最大可获取的寄存器个数，如果超过寄存器范围，剩下的由0填充
                                    int readableCountMax = keys.Count * 2 - i * 2;
                                    list.Add(AISlave.defalutValue[keys[i]][2]);
                                    list.Add(AISlave.defalutValue[keys[i]][3]);
                                    if (count <= readableCountMax)
                                    {
                                        //如果为奇数
                                        if ((count - 1) % 2 == 0)
                                        {
                                            for (int j = i + 1; j < count / 2; j++)
                                            {
                                                list.AddRange(AISlave.defalutValue[keys[j]]);
                                            }
                                        }
                                        else
                                        {
                                            int j = i;
                                            for (; j < (count - 2) / 2; j++)
                                            {
                                                list.AddRange(AISlave.defalutValue[keys[j]]);
                                            }
                                            list.Add(AISlave.defalutValue[keys[j]][0]);
                                            list.Add(AISlave.defalutValue[keys[j]][1]);
                                        }
                                    }
                                    else
                                    {
                                        //先填充有效寄存器数值
                                        for (int j = i + 1; j < keys.Count; j++)
                                        {
                                            list.AddRange(AISlave.defalutValue[keys[j]]);
                                        }
                                        //剩余的用0填充
                                        for (int j = 1; j <= count - (keys.Count - i - 1) * 2; j++)
                                        {
                                            list.AddRange(new byte[] { 0x00, 0x00 });
                                        }
                                    }
                                    break;

                                }
                            }
                        }
                    }
                    else
                    {
                        list.AddRange(new byte[] { (byte)AISlave.SlaveID, 0x84, errorType });
                    }
                    AISlave.LockSend(AISlave.CalcCRC16(list.ToArray()));
                    logHelper.WriteLogInfo($"发送数据：{BitConverter.ToString(list.ToArray()).Replace("-", " ")}", "data-监测仪接收数据");
                }
#if DEBUG
                MessageBox.Show(BitConverter.ToString(list.ToArray()).Replace("-", " "));
#endif
            }
            catch (Exception ex)
            {
                _logger.Error($"串口接收发生错误，{ex.Message}");
            }
        }

        private void btnConnect_Click(object sender, EventArgs e)
        {
            if (!AISlave.IsOpen)
            {
                PortInfo info = GetPortInfo(cBoxPort.Text, cBoxBaud.Text, cBoxCheckBits.Text, cBoxStopbits.Text, cBoxDataBits.Text, cBoxStation.Text);
                if (info == null)
                {
                    return;
                }
                if (AISlave.Connect(info.Name, info.BaudRate, info.Parity, info.StopBits, info.DataBits, info.SlaveID))
                {
                    btnConnect.Text = "已连接";
                    btnConnect.FillColor = Color.FromArgb(26, 101, 143);
                    //保存到配置文件里，同步记录连接状态
                    configuration.AppSettings.Settings["IsAutoConnectSlave"].Value = "true";
                    configuration.AppSettings.Settings["Port"].Value = cBoxPort.Text;
                    configuration.AppSettings.Settings["BaudRate"].Value = cBoxBaud.Text;
                    configuration.AppSettings.Settings["DataBits"].Value = cBoxDataBits.Text;
                    configuration.AppSettings.Settings["StopBits"].Value = cBoxStopbits.Text;
                    configuration.AppSettings.Settings["Parity"].Value = cBoxCheckBits.Text;
                    configuration.AppSettings.Settings["StationNo"].Value = cBoxStation.Text;
                    configuration.Save(ConfigurationSaveMode.Modified);
                    ConfigurationManager.RefreshSection("appSettings");
                    WriteLogDB("操作", $"串口{info.Name}连接成功");
                }
            }
            else
            {
                if (AISlave.Disconnect())
                {
                    btnConnect.FillColor = Color.Silver;
                    btnConnect.Text = "串口连接";
                    configuration.AppSettings.Settings["IsAutoConnectSlave"].Value = "false";
                    configuration.Save(ConfigurationSaveMode.Modified);
                    ConfigurationManager.RefreshSection("appSettings");
                    WriteLogDB("操作", "断开连接成功");
                }
            }
        }

        private void btnStationSet_Click(object sender, EventArgs e)
        {
            AISlave.SlaveID = int.Parse(cBoxStation.Text);
            WriteLogDB("操作", $"修改站号为{AISlave.SlaveID}");
            configuration.AppSettings.Settings["StationNo"].Value = cBoxStation.Text;
            configuration.Save(ConfigurationSaveMode.Modified);
            ConfigurationManager.RefreshSection("appSettings");
        }
        private void btnFlashPort_Click(object sender, EventArgs e)
        {
            cBoxPort.Items.Clear();
            cBoxPort.Items.AddRange(SerialPort.GetPortNames());
            cBoxPort.SelectedItem = ConfigurationManager.AppSettings["Port"];
        }

        #endregion
        /// <summary>
        /// 停止自动运行
        /// </summary>
        private void StopAutoTest()
        {
            try
            {
                cts?.Cancel();
            }
            catch (Exception ex)
            {
                _logger.Error(ex.Message);
                return;
            }

        }
        /// <summary>
        /// 训练模式主流程：开始→清洗→进样→(AI子流程)→静置→测量→结束
        /// </summary>
        private async Task<bool> AutoHuanshui()
        {
            bool re = false;
            if (!cts.IsCancellationRequested)
            {
                try
                {
                    // ===== 开始阶段 =====
                    _flow = "开始";
                    lbCurrentStaus.Text = "开始";
                    btnRunIndicator.FillColor = Color.FromArgb(26, 101, 143);
                    WriteLogDB("流程", "开始");
                    isRun = true;

                    // 打开样杯排阀 Y4，检查泵 Y1 是否开，若开则关
                    OperatorChannelMoreTimes(getOpenY4, 4, "样杯排阀", "打开", "1");
                    if (YStatus["Y1"] == "1")
                    {
                        WriteLogDB("流程", "检测到水泵开启，关闭水泵");
                        getCloseY1();
                    }
                    await Task.Delay(10000, cts.Token);

                    // ===== 清洗阶段 =====
                    _flow = "清洗";
                    lbCurrentStaus.Text = "清洗";
                    WriteLogDB("流程", "清洗");

                    // 先开进样阀 Y5，再开样杯进样阀 Y3，确认打开后再开泵 Y1
                    OperatorChannelMoreTimes(getOpenY5, 5, "进样阀", "打开", "1");
                    await Task.Delay(300, cts.Token);
                    OperatorChannelMoreTimes(getOpenY3, 3, "样杯进样阀", "打开", "1");
                    await Task.Delay(300, cts.Token);
                    OperatorChannelMoreTimes(getOpenY1, 1, "水泵", "打开", "1");
                    await Task.Delay(300, cts.Token);

                    // 清洗时长（秒）
                    int washSeconds = 60;
                    if (int.TryParse(txtWashTime.Text?.Trim(), out int wt) && wt > 0)
                        washSeconds = wt;

                    for (int i = 0; i < washSeconds; i++)
                    {
                        await Task.Delay(1000, cts.Token);
                        // 前半段维持 Y5/Y3/Y1 开启
                        if (i < washSeconds / 2)
                        {
                            if (YStatus["Y5"] == "0") getOpenY5();
                            if (YStatus["Y3"] == "0") getOpenY3();
                            if (YStatus["Y1"] == "0") getOpenY1();
                        }
                    }

                    // 清洗结束关样杯排阀 Y4
                    OperatorChannelMoreTimes(getCloseY4, 4, "样杯排阀", "关闭", "0");
                    await Task.Delay(300, cts.Token);

                    // ===== 进样阶段 =====
                    _flow = "进样";
                    lbCurrentStaus.Text = "进样";
                    WriteLogDB("流程", "进样");

                    // 进样最大等待时间（分钟，使用 CSTime 参数）
                    int sampleMaxSeconds = 30 * 60;
                    if (int.TryParse(txtCSTime.Text?.Trim(), out int st) && st > 0)
                        sampleMaxSeconds = st * 60;

                    bool levelReached = false;
                    for (int i = 0; i < sampleMaxSeconds; i++)
                    {
                        await Task.Delay(1000, cts.Token);
                        if (X1Value == "1")
                        {
                            levelReached = true;
                            WriteLogDB("流程", "检测到样杯液位");
                            break;
                        }
                    }

                    if (!levelReached)
                        WriteLogDB("报警", "进样异常：进样超时未检测到液位");

                    // 液位到达后等 10 秒，再关样杯进样阀 Y3
                    await Task.Delay(10000, cts.Token);
                    OperatorChannelMoreTimes(getCloseY3, 3, "样杯进样阀", "关闭", "0");
                    await Task.Delay(300, cts.Token);

                    // 启动 AI 子流程（并行运行，直到主流程结束）
                    _ = AutoAISubFlow();

                    // ===== 静置阶段 =====
                    _flow = "静置";
                    lbCurrentStaus.Text = "静置";
                    WriteLogDB("流程", "静置");

                    // 确保样杯进样阀 Y3 已关
                    if (YStatus["Y3"] == "1")
                        getCloseY3();

                    int staticMinutes = 5;
                    if (int.TryParse(txtStaticTime.Text?.Trim(), out int sm) && sm > 0)
                        staticMinutes = sm;
                    await Task.Delay(staticMinutes * 60000, cts.Token);

                    // ===== 测量阶段 =====
                    _flow = "测量";
                    lbCurrentStaus.Text = "测量";
                    WriteLogDB("流程", "测量");

                    // 发仪表测量指令，最多重试5次（每次间隔3秒）确认仪表处于测量状态
                    const int MAX_MEASURE_RETRY = 3;
                    for (int retry = 0; retry < MAX_MEASURE_RETRY; retry++)
                    {
                        if (Global.EQNames.Contains("总氮")) { YBStartTestZD(); await Task.Delay(700); }
                        if (Global.EQNames.Contains("氨氮")) { YBStartTestAD(); await Task.Delay(700); }
                        if (Global.EQNames.Contains("COD")) { YBStartTestCOD(); await Task.Delay(700); }
                        if (Global.EQNames.Contains("总磷")) { YBStartTestZL(); await Task.Delay(700); }

                        // 等待 3 秒后查询仪表状态
                        await Task.Delay(3000, cts.Token);
                       
                    }
                    // 等待测量时间
                    int testMinutes = 60;
                    if (int.TryParse(txtTestTime.Text?.Trim(), out int tm) && tm > 0)
                        testMinutes = tm;
                    await Task.Delay(testMinutes * 60000, cts.Token);

                    // 保存测量数据
                    MeasureData b = new()
                    {
                        ID = Math.Abs(_Snowflake.GetId()),
                        DataType = "仪表数据",
                        CollectTime = DateTime.Now,
                        TotalNitrogenTime = DateTime.Parse(Global.RecentValTimeZD),
                        TotalNitrogenVal = Global.YBRecentValZD,
                        AmmoniaADTime = DateTime.Parse(Global.RecentValTimeAD),
                        AmmoniaADValue = Global.YBRecentValAD,
                        TotalCODTime = DateTime.Parse(Global.RecentValTimeCOD),
                        TotalCODVal = Global.YBRecentValCOD,
                        TotalPhosphorustime = DateTime.Parse(Global.RecentValTimeZL),
                        TotalPhosphorusVal = Global.YBRecentValZL,
                        XSYDTime = DateTime.Parse(Global.RecentValTimeXS),
                        XSYDVal = Global.YBRecentValXS,
                        TurbidityVal = Global.YBRecentValZhuodu,
                        Remark = "周期"
                    };
                    await DataAPI.AddMeasureDataAsync(b);
                    logHelper.WriteLogInfo($"#{Global.YBRecentValZD};{Global.YBRecentValAD};{Global.YBRecentValCOD};{Global.YBRecentValZL};{Global.RecentValTimeZD};{Global.RecentValTimeAD};{Global.RecentValTimeCOD};{Global.RecentValTimeZL}", "吸光度");

                    // ===== 结束阶段 =====
                    lbCurrentStaus.Text = "结束";
                    WriteLogDB("流程", "结束");

                    // 关闭所有通道
                    for (int i = 0; i < 10; i++)
                    {
                        await Task.Delay(1000, cts.Token);
                        if (i == 0 || i == 3 || i == 6 || i == 9)
                        {
                            if (YStatus.Values.Contains("1"))
                                getCloseYAll();
                        }
                    }

                    re = true;
                    ErrZD = 0;
                    ErrAD = 0;
                    ErrCOD = 0;
                    ErrZL = 0;
                }
                catch (TaskCanceledException)
                {
                    cts?.Cancel();
                    WriteLogDB("告警", "流程被取消");
                }
                catch (Exception ex)
                {
                    cts?.Cancel();
                    _logger.Error(ex.Message);
                    WriteLogDB("告警", $"流程异常：{ex.Message}");
                }
            }
            return re;
        }

        //串口自定义参数
        private void mydefault_parameters(object sender, EventArgs e)
        {
            try
            {
                serialPort1.DataReceived += serialPort1_DataReceived;
                serialPortAI.DataReceived += serialPortAI_DataReceived;
                serialPortHJ.DataReceived += SerialPortHJ_DataReceived;

                if (serialPort1 != null && !serialPort1.IsOpen)
                    serialPort1.Open();
                if (serialPortAI != null && !serialPortAI.IsOpen)
                    serialPortAI.Open();
                if (serialPortHJ != null && !serialPortHJ.IsOpen)
                    serialPortHJ.Open();
            }
            catch (Exception ex)
            {
                _logger.Error("mydefault_parameters" + ex.Message);
            }
            finally
            {
                TryPowerOffRestart();
            }
        }

        private async void TryPowerOffRestart()
        {
            try
            {
                if (!IsFlowAutoRestartEnabled())
                {
                    _logger.Info("断电重启：FlowAutoRestart 非 Y，跳过自动启动");
                    return;
                }
                if (isRun)
                {
                    _logger.Info("断电重启：流程已在运行，跳过自动启动");
                    return;
                }

                await Task.Delay(3000);
                if (isRun) return;

                _logger.Info("断电重启：检测到自启标志为 Y，自动启动流程");
                WriteLogDB("操作", "断电重启：检测到自启标志为Y，自动启动流程");
                await StartFlowAsync();
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "断电重启自动启动失败");
                WriteLogDB("告警", $"断电重启自动启动失败：{ex.Message}");
            }
        }

        private void SerialPortHJ_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                if (serialPortHJ.IsOpen)
                {
                    Delay(150);
                    byte[] ReDatas = new byte[serialPortHJ.BytesToRead];
                    serialPortHJ.Read(ReDatas, 0, ReDatas.Length);//读取数据
                    this.AddDataHJ(ReDatas);//输出数据                                    
                }
                else
                    _logger.Error("请先打开仪表串口");
            }
            catch (Exception ex)
            {
                _logger.Error("serialPortHJ_DataReceived" + ex.Message);
                serialPortHJ.Close();
            }
        }

        private void AddDataHJ(byte[] data)
        {
            StringBuilder sb = new();
            for (int i = 0; i < data.Length; i++)
                sb.AppendFormat("{0:x2}" + " ", data[i]);
            var content = sb.ToString().ToUpper();
            _logger.Info(content);
            try
            {
                if (content.Contains(" "))
                {
                    var contentArray = content.Split(' ');
                    if (contentArray.Length == 104)
                    {
                        var ZdCode = contentArray[5] + contentArray[6] + contentArray[3] + contentArray[4];//总氮编码21001
                        var ZdCodeValue = To16Convert10(ZdCode);
                        var TestTime = "20" + contentArray[13] + "-" + contentArray[14] + "-" + contentArray[15] + " " + contentArray[16] + ":" + contentArray[17] + ":" + contentArray[18];//测量时间                             
                        var TestVal = contentArray[21] + contentArray[22] + contentArray[19] + contentArray[20];
                        var TestValue = Convert.ToDecimal(Math.Round(get16tofloat(TestVal), 3));
                        var TestTimeBY = "20" + contentArray[35] + "-" + contentArray[36] + "-" + contentArray[37] + " " + contentArray[38] + ":" + contentArray[39] + ":" + contentArray[40];//标样核查时间                               
                        var TestValBY = contentArray[43] + contentArray[44] + contentArray[41] + contentArray[42];
                        var TestValueBY = Convert.ToDecimal(Math.Round(get16tofloat(TestValBY), GetDataCount()));
                        var TestTimeLD = "20" + contentArray[79] + "-" + contentArray[80] + "-" + contentArray[81] + " " + contentArray[82] + ":" + contentArray[83] + ":" + contentArray[84];//零点核查核查时间                               
                        var TestValLD = contentArray[87] + contentArray[88] + contentArray[85] + contentArray[86];
                        var TestValueLD = Convert.ToDecimal(Math.Round(get16tofloat(TestValLD), GetDataCount()));
                        if (int.Parse(contentArray[14]) > 0 && int.Parse(contentArray[15]) > 0)
                        {
                            if (contentArray[0] == "01")
                            {
                                Global.RecentValTimeZD = TestTime;
                                Global.YBRecentValZD = TestValue;
                            }
                            else if (contentArray[0] == "02")
                            {
                                Global.RecentValTimeAD = TestTime;
                                Global.YBRecentValAD = TestValue;
                            }
                            else if (contentArray[0] == "03")
                            {
                                Global.RecentValTimeCOD = TestTime;
                                Global.YBRecentValCOD = TestValue;
                            }
                            else if (contentArray[0] == "04")
                            {
                                Global.RecentValTimeZL = TestTime;
                                Global.YBRecentValZL = TestValue;
                            }
                        }
                        ProcessQCRecords(contentArray, TestTimeBY, TestValueBY, TestTimeLD, TestValueLD);
                    }
                    else if (contentArray.Length == 18)
                    {
                        var DeviceTime = "20" + contentArray[3] + "-" + contentArray[4] + "-" + contentArray[5] + " " + contentArray[6] + ":" + contentArray[7] + ":" + contentArray[8];
                        var workStatus = To16Convert10(contentArray[9] + contentArray[10]);

            AISlaveInit();
        }

        #region 通道多次尝试机制
        private void OperatorChannelMoreTimes(Action operation, int channel, string channelName, string action, string status)
        {
            int i = 0;
            for (; i < _tryTimes; i++)
            {
                operation();
                Delay(2000);
                if (cts.IsCancellationRequested || YStatus[$"Y{channel}"] == status)
                    break;
            }
            if (i == _tryTimes && YStatus[$"Y{channel}"] != status)
            {
                WriteLogDB("告警", $"{_flow}异常,{action}{channelName}失败");
            }
        }

        private void CloseAllChannelsMoreTimes()
        {
            int i = 0;
            for (; i < _tryTimes; i++)
            {
                getCloseYAll();
                Delay(2000);
                if (cts.IsCancellationRequested || !YStatus.Values.Contains("1"))
                    break;
            }
            if (i == _tryTimes && YStatus.Values.Contains("1"))
            {
                WriteLogDB("告警", $"{_flow}异常,关闭所有通道失败");
            }
        }

        private void NormalCloseAllChannelsMoreTimes()
        {
            int i = 0;
            for (; i < _tryTimes; i++)
            {
                getCloseYAll();
                Delay(2000);
                if (!YStatus.Values.Contains("1"))
                    break;
            }
            if (i == _tryTimes && YStatus.Values.Contains("1"))
            {
                WriteLogDB("告警", $"强制结束异常,关闭所有通道失败");
            }
        }
        #endregion


        /// <summary>
        /// 执行单次子流程周期：换水（Y5+Y1）→ 静置（关Y5/Y1）→ 测量（AI测量模式）
        /// 推理模式换水前会先打开样杯进样阀/排阀，连续10秒检测不到AI液位后关闭
        /// </summary>
        private async Task ExecuteSingleSubFlowCycle()
        {
            // ===== 推理模式：换水前预排 =====
            if (_flow == "推理模式")
            {
                _subFlow = "子流程预排";
                UpdateCurrentFlowStatus("预排");
                WriteLogDB("流程", "推理模式换水前预排开始");

                OperatorChannelMoreTimes(getOpenY3, 3, "样杯进样阀", "打开", "1");
                await Task.Delay(300, cts.Token);
                OperatorChannelMoreTimes(getOpenY4, 4, "样杯排阀", "打开", "1");
                await Task.Delay(300, cts.Token);

                int noAiLevelSeconds = 0;
                while (noAiLevelSeconds < 10)
                {
                    await Task.Delay(1000, cts.Token);
                    if (X2Value != "1")
                        noAiLevelSeconds++;
                    else
                        noAiLevelSeconds = 0;

                    if (YStatus["Y3"] == "0") getOpenY3();
                    if (YStatus["Y4"] == "0") getOpenY4();
                }

                OperatorChannelMoreTimes(getCloseY3, 3, "样杯进样阀", "关闭", "0");
                await Task.Delay(300, cts.Token);
                OperatorChannelMoreTimes(getCloseY4, 4, "样杯排阀", "关闭", "0");
                await Task.Delay(300, cts.Token);
                WriteLogDB("流程", "推理模式换水前预排结束（连续10秒未检测到AI液位）");
            }

            // ===== 换水阶段 =====
            _subFlow = "子流程换水";
            if (_flow == "推理模式")
                UpdateCurrentFlowStatus("换水");
            WriteLogDB("流程", "子流程换水开始");

            // 先开进样阀 Y5，再开水泵 Y1
            if (YStatus["Y5"] == "0")
                OperatorChannelMoreTimes(getOpenY5, 5, "进样阀", "打开", "1");
            await Task.Delay(300, cts.Token);
            if (YStatus["Y1"] == "0")
                OperatorChannelMoreTimes(getOpenY1, 1, "水泵", "打开", "1");

            int huanshuiSeconds = 600;
            if (int.TryParse(txtSubFlowTestTime.Text?.Trim(), out int ht) && ht > 0)
                huanshuiSeconds = ht;
            await Task.Delay(huanshuiSeconds * 1000, cts.Token);

            // ===== 静置阶段 =====
            _subFlow = "子流程静置";
            if (_flow == "推理模式")
                UpdateCurrentFlowStatus("静置");
            WriteLogDB("流程", "子流程静置开始");

            // 同时关闭进样阀 Y5 和水泵 Y1
            OperatorChannelMoreTimes(getCloseY5, 5, "进样阀", "关闭", "0");
            await Task.Delay(300, cts.Token);
            OperatorChannelMoreTimes(getCloseY1, 1, "水泵", "关闭", "0");
            await Task.Delay(300, cts.Token);

            int subFlowStaticSeconds = 300;
            if (int.TryParse(txtSubFlowStaticTime.Text?.Trim(), out int sst) && sst > 0)
                subFlowStaticSeconds = sst;
            await Task.Delay(subFlowStaticSeconds * 1000, cts.Token);

            // ===== 测量阶段 =====
            _subFlow = "子流程测量";
            if (_flow == "推理模式")
                UpdateCurrentFlowStatus("测量");
            WriteLogDB("流程", "子流程测量开始");

            // 发送 AI 测量指令，并轮询确认 AiStatusVal == "02"
            const int MAX_AI_RETRY = 5;
            bool aiMeasuring = false;
            for (int retry = 0; retry < MAX_AI_RETRY; retry++)
            {
                if (X2Value != "1")
                {
                    WriteLogDB("报警", "AI液位信号丢失，暂停发送测量指令");
                    await Task.Delay(3000, cts.Token);
                    continue;
                }

                SendAIData(strToHexByte(CalcCRC16("01 06 07 07 00 02")));

                await Task.Delay(15000, cts.Token);
                if (AiStatusVal == "02")
                {
                    aiMeasuring = true;
                    WriteLogDB("流程", "AI已进入测量模式");
                    break;
                }
            }

            if (!aiMeasuring)
            {
                WriteLogDB("报警", "子流程测量异常：多次发送后AI未进入测量模式");
            }
          
            int aiReadMinutes = 1;
            if (int.TryParse(txtSubFlowAIReadTime.Text?.Trim(), out int art) && art > 0)
                aiReadMinutes = art;
            WriteLogDB("流程", $"AI读数等待{aiReadMinutes}分钟");
            await Task.Delay(aiReadMinutes * 60000, cts.Token);
                SendAIData(strToHexByte(CalcCRC16("01 06 07 07 00 00")));
            WriteLogDB("流程", "子流程测量结束");
            
        }

        /// <summary>
        /// 推理模式入口：无主流程，直接循环运行AI子流程（换水→静置→测量）
        /// </summary>
        private async Task AutoInferenceMode()
        {
            try
            {
                isRun = true;
                _flow = "推理模式";
                btnRunIndicator.FillColor = Color.FromArgb(26, 101, 143);
                WriteLogDB("流程", "推理模式启动");
                await AutoAISubFlow();
            }
            catch (TaskCanceledException)
            {
                WriteLogDB("告警", "推理模式被取消");
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "推理模式执行异常");
                WriteLogDB("告警", $"推理模式异常：{ex.Message}");
            }
        }

        /// <summary>
        /// AI子流程：循环执行直到主流程停止
        /// </summary>
        private async Task AutoAISubFlow()
        {
            try
            {
                // 使用 while 循环，避免递归消耗内存
                while (isRun && !cts.Token.IsCancellationRequested)
                {
                    await ExecuteSingleSubFlowCycle();

                    // 检查是否需要继续循环（在 while 条件中已检查，这里可以添加额外检查）
                    if (!isRun || cts.Token.IsCancellationRequested)
                    {
                        WriteLogDB("流程", "子流程停止（主流程已停止）");
                        break;
                    }


                }

                WriteLogDB("流程", "AI子流程循环结束");
            }
            catch (TaskCanceledException)
            {
                WriteLogDB("流程", "AI子流程被取消或者周期时间到");
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "AI子流程执行异常");
                WriteLogDB("报警", $"AI子流程异常：{ex.Message}");
            }
        }

        private void GetYBDisplay()
        {
            try
            {
                if (Global.EQNames.Contains("总氮"))
                    groupBoxZD.Visible = true;
                if (Global.EQNames.Contains("氨氮"))
                    groupBoxAD.Visible = true;
                if (Global.EQNames.Contains("COD"))
                    groupBoxCOD.Visible = true;
                if (Global.EQNames.Contains("总磷"))
                    groupBoxZL.Visible = true;
            }
            catch (Exception ex)
            {
                ShowTip.ShowErrorTip(ex.Message);
                _logger.Error(ex, "获取设备显示配置时发生异常");
            }
        }

        private async void TimerLiucheng_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            isRun = false;
            cts?.Cancel();
            cts = new();
            string timerRunMode = comBoxRunMode.Text?.Trim() ?? "训练模式";
            if (timerRunMode == "推理模式")
                await AutoInferenceMode();
            else
                await AutoHuanshui();
        }

        /// <summary>
        /// AI子流程定时器事件处理：周期执行AI子流程
        /// </summary>
        private async void TimerAISubFlow_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            try
            {
                // 检查主流程是否在运行
                if (!isRun)
                {

                    return;
                }

                // 执行AI子流程
                await AutoAISubFlow();
            }
            catch (TaskCanceledException)
            {
                WriteLogDB("流程", "AI子流程定时器执行被取消");
            }
            catch (Exception ex)
            {
                _logger.Error(ex, "AI子流程定时器执行异常");
                WriteLogDB("报警", $"AI子流程定时器异常：{ex.Message}");
            }
        }

        private void DatatoDBTimer_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            var ctTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:00");
            string remark;
            if (DateTime.Now.Minute == 0)
                remark = "小时";
            else
                remark = "分钟";
            Task.Run(async () =>
            {
                MeasureData a = new()
                {
                    ID = Math.Abs(_Snowflake.GetId()),
                    DataType = "AI数据",
                    CollectTime = DateTime.Parse(ctTime),
                    TotalNitrogenVal = Global.RecentValZD,
                    AmmoniaADValue = Global.RecentValAD,
                    TotalCODVal = Global.RecentValCOD,
                    TotalPhosphorusVal = Global.RecentValZL,
                    XSYDVal = Global.RecentValXS,
                    TurbidityVal = Global.RecentValZhuodu,
                    Remark = remark
                };
                await DataAPI.AddMeasureDataAsync(a);
                logHelper.WriteLogInfo(Global.YSRecentValCOD + ";" + Global.YSRecentValXS + ";" + Global.YSRecentValZD + ";" + Global.YSRecentValAD + ";" + Global.YSRecentValZL + ";" + Global.YSRecentValZhuodu + ";", "因子");
                logHelper.WriteLogInfo(AllXGD, "吸光度");


            });

            //MeasureData b = new()
            //{
            //    ID = Math.Abs(_Snowflake.GetId()),
            //    DataType = "仪表数据",
            //    CollectTime = DateTime.Parse(ctTime),
            //    TotalNitrogenTime = DateTime.Parse(Global.RecentValTimeZD),
            //    TotalNitrogenVal = Global.YBRecentValZD,
            //    AmmoniaADTime = DateTime.Parse(Global.RecentValTimeAD),
            //    AmmoniaADValue = Global.YBRecentValAD,
            //    TotalCODTime = DateTime.Parse(Global.RecentValTimeCOD),
            //    TotalCODVal = Global.YBRecentValCOD,
            //    TotalPhosphorustime = DateTime.Parse(Global.RecentValTimeZL),
            //    TotalPhosphorusVal = Global.YBRecentValZL,
            //    XSYDTime = DateTime.Parse(Global.RecentValTimeXS),
            //    XSYDVal = Global.YBRecentValXS,
            //    TurbidityVal = Global.YBRecentValZhuodu,
            //    Remark = remark
            //};
            //await DataAPI.AddMeasureDataAsync(b);

            Task.Run(() =>
            {
                if (AiStatusVal == "02")
                {
                    string data = "CollectTime={0},";
                    if (Global.EQNames.Contains("总氮"))
                    {
                        data += "ZDVal=" + Global.YBRecentValZD + "," + "AIZDVal=" + Global.RecentValZD + ",";
                    }
                    if (Global.EQNames.Contains("氨氮"))
                    {
                        data += "ADVal=" + Global.YBRecentValAD + "," + "AIADVal=" + Global.RecentValAD + ",";
                    }
                    if (Global.EQNames.Contains("COD"))
                    {
                        data += "CODVal=" + Global.YBRecentValCOD + "," + "AICODVal=" + Global.RecentValCOD + ",";
                    }
                    if (Global.EQNames.Contains("总磷"))
                    {
                        data += "ZLVal=" + Global.YBRecentValZL + "," + "AIZLVal=" + Global.RecentValZL + ",";
                    }
                    var cTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:00");
                    string dataNew = string.Format(data.Remove(data.Length - 1), ctTime);
                    PublishMq("sys/device/" + ConfigurationManager.AppSettings["MN2"] + "/message/2051", dataNew);
                    //string UploadXGDNew = string.Format("CollectTime={0}," + UploadXGD.Remove(UploadXGD.Length - 1), ctTime);
                    //PublishMq("sys/device/" + ConfigurationManager.AppSettings["MN2"] + "/message/2000", UploadXGDNew);
                }
            });
        }
        private async void IsStartTimer_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            if (!isRun)
            {
                // 使用 TryParse 避免 FormatException，添加输入验证
                if (int.TryParse(txtStartHour.Text?.Trim(), out int startHour) &&
                    int.TryParse(txtStartMin.Text?.Trim(), out int startMin) &&
                    DateTime.Now.Hour == startHour &&
                    DateTime.Now.Minute == startMin)
                {
                    if (!timerLiucheng.Enabled)
                    {
                        // 使用 TryParse 解析周期时间，默认值 60 分钟
                        if (int.TryParse(txtZQTime.Text?.Trim(), out int cycleTime) && cycleTime > 0)
                        {
                            timerLiucheng.Interval = cycleTime * 60000;
                        }
                        else
                        {
                            // 如果解析失败，使用默认值 60 分钟
                            timerLiucheng.Interval = 60 * 60000;
                        }
                        timerLiucheng.Start();
                    }
                    SetFlowAutoRestart(true);
                    cts?.Cancel();
                    cts = new();
                    string autoRunMode = comBoxRunMode.Text?.Trim() ?? "训练模式";
                    if (autoRunMode == "推理模式")
                        await AutoInferenceMode();
                    else
                        await AutoHuanshui();
                }
            }
        }

        private void TimerWC_Elapsed(object sender, System.Timers.ElapsedEventArgs e)
        {
            Task.Run(() =>
            {
                getAIStatus();
                Delay(800);
                getAIWarn();
                Delay(800);
                getAICheckData();
                Delay(800);
                getAIData();
            });
            Task.Run(() =>
            {
                PostStatusZD();
                Delay(1000);
                PostStatusAD();
                Delay(1000);
                PostStatusCOD();
                Delay(1000);
                PostStatusZL();
                Delay(3000);
                PostHomeDataZD();
                Delay(1000);
                PostHomeDataAD();
                Delay(1000);
                PostHomeDataCOD();
                Delay(1000);
                PostHomeDataZL();
            });
            Task.Run(() =>
            {
                string dataS = "CollectTime={0},AIVal={1},", dataE = "CollectTime={0},";
                if (Global.EQNames.Contains("总氮"))
                {
                    dataS += "ZDVal=" + sZDStatus + ",";
                    dataE += "ZDVal=" + sZDValue + ",";
                }
                if (Global.EQNames.Contains("氨氮"))
                {
                    dataS += "ADVal=" + sADStatus + ",";
                    dataE += "ADVal=" + sADValue + ",";
                }
                if (Global.EQNames.Contains("COD"))
                {
                    dataS += "CODVal=" + sCODStatus + ",";
                    dataE += "CODVal=" + sCODValue + ",";
                }
                if (Global.EQNames.Contains("总磷"))
                {
                    dataS += "ZLVal=" + sZLStatus + ",";
                    dataE += "ZLVal=" + sZLValue + ",";
                }
                string Sdata = string.Format(dataS.Remove(dataS.Length - 1), DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), int.Parse(AiStatusVal));
                PublishMq("sys/device/" + ConfigurationManager.AppSettings["MN2"] + "/message/1000", Sdata);
                string Edata = string.Format(dataE.Remove(dataE.Length - 1), DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"));
                PublishMq("sys/device/" + ConfigurationManager.AppSettings["MN2"] + "/message/3000", Edata);
            });
        }

        private void PostStatusZD()
        {
            string strSendZd = "01 03 10 80 00 06";
            try
            {
                if (serialPortHJ != null && !serialPortHJ.IsOpen)
                    serialPortHJ.Open();
                var sendData1 = strToHexByte(CalcCRC16(strSendZd).Trim());
                SendYBData(sendData1);
            }
            catch (Exception ex)
            {
                _logger.Error("仪表" + ex.Message);
                return;
            }
        }
        private void PostStatusAD()
        {
            string strSendZd = "02 03 10 80 00 06";

        private void comBoxMode_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (comBoxMode.SelectedItem.ToString() == "AI")
            {
                lbFactor.Visible = false;
                comBoxFactor.Visible = false;
            }
            else if (comBoxMode.SelectedItem.ToString() == "普通")
            {
                lbFactor.Visible = true;
                comBoxFactor.Visible = true;
            }
        }

        private void btnSave_Click(object sender, EventArgs e)
        {
            configuration.AppSettings.Settings["starthour"].Value = txtStartHour.Text.Trim();
            configuration.AppSettings.Settings["startmin"].Value = txtStartMin.Text.Trim();
            configuration.AppSettings.Settings["CycleTime"].Value = txtZQTime.Text.Trim();
            configuration.AppSettings.Settings["CSTime"].Value = txtCSTime.Text.Trim();
            configuration.AppSettings.Settings["TestTime"].Value = txtTestTime.Text.Trim();
            configuration.AppSettings.Settings["WashTime"].Value = txtWashTime.Text.Trim();
            if (configuration.AppSettings.Settings["StaticTime"] == null)
                configuration.AppSettings.Settings.Add("StaticTime", txtStaticTime.Text.Trim());
            else
                configuration.AppSettings.Settings["StaticTime"].Value = txtStaticTime.Text.Trim();
            if (configuration.AppSettings.Settings["SubFlowTestTime"] == null)
                configuration.AppSettings.Settings.Add("SubFlowTestTime", txtSubFlowTestTime.Text.Trim());
            else
                configuration.AppSettings.Settings["SubFlowTestTime"].Value = txtSubFlowTestTime.Text.Trim();
            if (configuration.AppSettings.Settings["SubFlowStaticTime"] == null)
                configuration.AppSettings.Settings.Add("SubFlowStaticTime", txtSubFlowStaticTime.Text.Trim());
            else
                configuration.AppSettings.Settings["SubFlowStaticTime"].Value = txtSubFlowStaticTime.Text.Trim();
            if (configuration.AppSettings.Settings["SubFlowAIReadTime"] == null)
                configuration.AppSettings.Settings.Add("SubFlowAIReadTime", txtSubFlowAIReadTime.Text.Trim());
            else
                configuration.AppSettings.Settings["SubFlowAIReadTime"].Value = txtSubFlowAIReadTime.Text.Trim();
            if (configuration.AppSettings.Settings["RunMode"] == null)
                configuration.AppSettings.Settings.Add("RunMode", comBoxRunMode.Text?.Trim() ?? "训练模式");
            else
                configuration.AppSettings.Settings["RunMode"].Value = comBoxRunMode.Text?.Trim() ?? "训练模式";
            configuration.Save(ConfigurationSaveMode.Modified);

            // 记录流程参数设置保存日志
            string logContent = $"流程参数设置已保存 - " +
                $"运行模式:{comBoxRunMode.Text?.Trim()}, " +
                $"流程启动时间:{txtStartHour.Text.Trim()}:{txtStartMin.Text.Trim()}, " +
                $"周期时间:{txtZQTime.Text.Trim()}min, " +
                $"进样超时:{txtCSTime.Text.Trim()}min, " +
                $"测量时间:{txtTestTime.Text.Trim()}min, " +
                $"清洗时间:{txtWashTime.Text.Trim()}s, " +
                $"主流程静置:{txtStaticTime.Text.Trim()}min, " +
                $"子流程换水:{txtSubFlowTestTime.Text.Trim()}s, " +
                $"子流程静置:{txtSubFlowStaticTime.Text.Trim()}s, " +
                $"AI读数时间:{txtSubFlowAIReadTime.Text.Trim()}min";
            WriteLogDB("操作", logContent);

            ShowTip.ShowSuccessTip("保存成功！");
        }

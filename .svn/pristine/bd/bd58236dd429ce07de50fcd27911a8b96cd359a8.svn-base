using System;

namespace WaterStation.Client.Model.LayoutDto
{
    public class ResultSampleRecordDto
    {

        /// <summary>
        /// 主键ID
        /// </summary>
        public long ID { get; set; }

        /// <summary>
        /// 留样因子名称
        /// </summary>
        public string SampleName { get; set; }

        /// <summary>
        /// 留样因子编码
        /// </summary>
        public string SampleCode { get; set; }
        /// <summary>
        /// 备注
        /// </summary>
        public string Remark { get; set; }

        /// <summary>
        /// 留样时间
        /// </summary>
        public DateTime SampleTime { get; set; }

        /// <summary>
        /// 因子测量时间
        /// </summary>
        public DateTime TestTime { get; set; }
        /// <summary>
        /// 因子测量值
        /// </summary>
        public decimal TestVal { get; set; }

        /// <summary>
        /// 当前页
        /// </summary>
        public int PageIndex { get; set; }
        /// <summary>
        /// 每页条数
        /// </summary>
        public int PageSize { get; set; }
        /// <summary>
        /// 总记录数
        /// </summary>
        public int PageCount { get; set; }

        public DateTime SatrtTime { get; set; } = new DateTime(1900, 1, 1);

        public DateTime EndTime { get; set; } = new DateTime(1900, 1, 1);

    }
}

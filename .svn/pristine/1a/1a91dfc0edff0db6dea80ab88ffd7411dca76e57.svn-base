        public BroasClientNew()
        {
            var userinfo = Global.userInfoDto;//判断是否是直接通主界面加载
            if (userinfo == null)
                LoginInfo();//模拟用户登录 
            InitializeComponent();
            this.WindowState = FormWindowState.Maximized;
            UserControlIniti();
            MyMessager msg = new MyMessager();
